{
  "ci": {
    "collect": {
      "startServerCommand": "npm run start -w web",
      "url": ["http://localhost:3000/"],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "onlyCategories": ["performance", "accessibility"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.85 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }]
      }
    }
  }
}
